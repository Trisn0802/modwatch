# ---------------------------------------------------------------------------
# ModWatch environment
# Copy this file to .env and replace every value marked "change me".
# Compose reads this file for interpolation. The app only receives the
# variables listed in docker-compose.yml, not the whole file.
# ---------------------------------------------------------------------------

# PostgreSQL. Use a long random password, letters and numbers only.
POSTGRES_USER=modwatch
POSTGRES_PASSWORD=change-me-long-random-database-password
POSTGRES_DB=modwatch

# Session signing key. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-random-session-secret-at-least-32-characters

# Host port for the web UI. The container always listens on 3000.
MODWATCH_PORT=3411

# First admin, created only when the database has no users at all.
# The password must be at least 8 characters. Change it after first sign-in.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# Public URL, used for links and secure cookies. Empty for local HTTP.
# Set to https://modwatch.example.com behind a reverse proxy.
APP_URL=

# Set to 1 when a reverse proxy terminates HTTPS in front of the app.
TRUST_PROXY=0

# Scheduler defaults. The interval can also be changed in Settings.
CHECK_INTERVAL_HOURS=6
MAX_UPLOAD_MB=100
APP_VERSION=1.0

# Connectors. Modrinth works without a key. The rest are optional.
# CurseForge API key: https://console.curseforge.com/
CURSEFORGE_API_KEY=
# GitHub token raises the rate limit and unlocks private release assets.
GITHUB_TOKEN=

# MyWebhook relay (recommended). Create a hook at https://webhook.trisnahome.my.id
# and paste its endpoint here or in Settings → Notifications.
WEBHOOK_URL=

# Legacy direct Telegram delivery (optional; MyWebhook is preferred).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Local development only. Run PostgreSQL with docker-compose.dev.yml and use
# these values from server/: npm run dev
# DEV_DATABASE_URL=postgres://modwatch:change-me@127.0.0.1:5433/modwatch
# DEV_PORT=3411
