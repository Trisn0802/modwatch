{% extends "layout.njk" %}
{% from "partials/icon.njk" import icon %}
{% from "partials/mark.njk" import mark %}

{% block content %}
<div class="state-page">
  <div class="state-inner">
    <div class="state-mark">{{ mark(44, assetVersion) }}</div>
    <p class="state-code">404 · NOT FOUND</p>
    <h1 class="state-title">That page is not here</h1>
    <p class="state-text">The instance, mod or page may have been deleted, or the address is off by a character.</p>
    <div class="state-actions">
      <a class="btn primary" href="/">Back to overview</a>
      <a class="btn" href="/instances">Browse instances</a>
    </div>
  </div>
</div>
{% endblock %}
