{% extends "layout.njk" %}
{% from "partials/icon.njk" import icon %}

{% block content %}
<div class="page-head">
  <div class="page-head-main">
    <p class="eyebrow"><span class="dot {% if pending.length or importPending.length or rolePending.length %}warn{% else %}live{% endif %}"></span> Member requests</p>
    <h1 class="page-title">Approvals</h1>
    <p class="page-sub">Mods, packs and account roles members asked for. Approving writes the change; rejecting leaves the workspace untouched.</p>
  </div>
  <div class="page-actions">
    <span class="pill {% if pending.length or importPending.length or rolePending.length %}warn{% else %}pos{% endif %}"><span class="dot"></span>{{ pending.length + importPending.length + rolePending.length }} waiting</span>
  </div>
</div>

<div class="layout-main">
  <div class="stack">
  <section class="panel">
    <div class="panel-head">
      <div>
        <h2 class="panel-title">Pack imports</h2>
        <p class="panel-sub">Member .mrpack uploads waiting for a content review</p>
      </div>
      <span class="count-note">{{ importPending.length }} waiting</span>
    </div>
    {% for request in importPending %}
    <article class="request-card">
      <div class="request-head">
        <div>
          <p class="request-mod">{% if request.mode == 'update' %}Update · {{ request.instance_name }}{% else %}{{ request.pack_name or request.file_name }}{% endif %}</p>
          <div class="request-meta">
            <span>{{ request.requester_name }} · {{ request.requester_email }}</span>
            <span>·</span>
            <span>{{ request.created_at | relative }}</span>
          </div>
        </div>
        <span class="pill {% if request.mode == 'update' %}warn{% else %}info{% endif %}">{% if request.mode == 'update' %}Pack update{% else %}{{ request.counts.projects or 0 }} projects{% endif %}</span>
      </div>
      <div class="request-scope">
        <div class="scope compact">
          <span class="scope-cell"><span class="scope-label">Minecraft</span><strong>{{ request.mc_version or '—' }}</strong></span>
          <span class="scope-cell"><span class="scope-label">Loader</span><strong>{{ request.loader | loaderLabel }}{% if request.loader_version %} {{ request.loader_version }}{% endif %}</strong></span>
          <span class="scope-cell"><span class="scope-label">Pack files</span><strong>{{ request.counts.files or 0 }}</strong></span>
        </div>
      </div>
      <p class="faint" style="margin-top:10px;font-size:10.5px;word-break:break-all">{{ request.file_name }}</p>
      <div class="btn-row" style="margin-top:12px">
        <a class="btn primary" href="/approvals/imports/{{ request.id }}">{{ icon('search') }} {% if request.mode == 'update' %}Review update{% else %}Review contents{% endif %}</a>
      </div>
    </article>
    {% else %}
    <div class="panel-body">
      <div class="empty-state">
        <div class="empty-inner">
          <span class="empty-icon">{{ icon('upload') }}</span>
          <p class="empty-title">No pack imports waiting</p>
          <p class="empty-text">When a member uploads a .mrpack, the full preview lands here for an admin to review before an instance is created.</p>
        </div>
      </div>
    </div>
    {% endfor %}
  </section>

  <section class="panel">
    <div class="panel-head">
      <div>
        <h2 class="panel-title">Account role requests</h2>
        <p class="panel-sub">Members asking for the admin role</p>
      </div>
      <span class="count-note">{{ rolePending.length }} waiting</span>
    </div>
    {% for request in rolePending %}
    <article class="request-card">
      <div class="request-head">
        <div>
          <p class="request-mod">{{ request.requester_name }}</p>
          <div class="request-meta">
            <span>{{ request.requester_email }}</span>
            <span>·</span>
            <span>{{ request.created_at | relative }}</span>
          </div>
        </div>
        <span class="pill warn">Admin access</span>
      </div>
      <div class="request-scope">
        <div class="scope compact">
          <span class="scope-cell"><span class="scope-label">Current role</span><strong>{{ request.current_role | capitalize }}</strong></span>
          <span class="scope-cell"><span class="scope-label">Account</span><strong>{{ request.account_status | capitalize }}</strong></span>
          <span class="scope-cell"><span class="scope-label">Requested</span><strong>Admin</strong></span>
        </div>
      </div>
      {% if request.note %}<p class="faint" style="margin-top:10px;font-size:10.5px">“{{ request.note }}”</p>{% endif %}
      <form class="request-forms" method="post" action="/approvals/roles/{{ request.id }}/approve">
        {% include "partials/csrf.njk" %}
        <label class="sr-only" for="role-note-{{ request.id }}">Decision note</label>
        <input class="input" id="role-note-{{ request.id }}" name="note" type="text" placeholder="Optional note back to {{ request.requester_name }}">
        <div class="btn-row">
          <button class="btn primary" type="submit">{{ icon('check') }} Approve admin</button>
          <button class="btn danger" type="submit" formaction="/approvals/roles/{{ request.id }}/reject" formnovalidate>{{ icon('close') }} Reject</button>
        </div>
      </form>
    </article>
    {% else %}
    <div class="panel-body">
      <div class="empty-state">
        <div class="empty-inner">
          <span class="empty-icon">{{ icon('user') }}</span>
          <p class="empty-title">No account requests waiting</p>
          <p class="empty-text">A member asking for the admin role from Account lands here for a decision.</p>
        </div>
      </div>
    </div>
    {% endfor %}
  </section>

  <section class="panel">
    <div class="panel-head">
      <div>
        <h2 class="panel-title">Waiting for a decision</h2>
        <p class="panel-sub">Oldest request first</p>
      </div>
    </div>
    {% for request in pending %}
    {% set src = request.payload.source | sourceMeta %}
    <article class="request-card">
      <div class="request-head">
        <div>
          <p class="request-mod">{{ request.payload.name }}</p>
          <div class="request-meta">
            <span>{{ request.requester_name }} · {{ request.requester_email }}</span>
            <span>·</span>
            <span>{{ request.instance_name }}</span>
            <span>·</span>
            <span>{{ request.created_at | relative }}</span>
          </div>
        </div>
        <span class="pill info">{{ src.label }}</span>
      </div>

      <div class="request-scope">
        <div class="scope compact">
          <span class="scope-cell"><span class="scope-label">Installed</span><strong>{{ request.payload.installed_version or '—' }}</strong></span>
          <span class="scope-cell"><span class="scope-label">Side</span><strong>{{ request.payload.side | sideLabel }}</strong></span>
          <span class="scope-cell"><span class="scope-label">Policy</span><strong>{{ request.payload.channel_policy | channelLabel }}</strong></span>
        </div>
      </div>

      {% if request.payload.project_url %}
      <p class="faint" style="margin-top:10px;font-size:10.5px;word-break:break-all"><a class="card-link" href="{{ request.payload.project_url }}" target="_blank" rel="noopener noreferrer">{{ request.payload.project_url }} {{ icon('external') }}</a></p>
      {% endif %}

      <form class="request-forms" method="post" action="/approvals/{{ request.id }}/approve"
        data-progress-title="Approving {{ request.payload.name }}"
        data-progress-message="Writing the mod to {{ request.instance_name }} and starting a source check."
        data-progress-steps="Lock the request|Add the mod to the instance|Save the decision|Start the source check|Reload approvals">
        {% include "partials/csrf.njk" %}
        <label class="sr-only" for="note-{{ request.id }}">Decision note</label>
        <input class="input" id="note-{{ request.id }}" name="note" type="text" placeholder="Optional note back to {{ request.requester_name }}">
        <div class="btn-row">
          <button class="btn primary" type="submit">{{ icon('check') }} Approve and add</button>
          <button class="btn danger" type="submit" formaction="/approvals/{{ request.id }}/reject" formnovalidate>{{ icon('close') }} Reject</button>
        </div>
      </form>
    </article>
    {% else %}
    <div class="panel-body">
      <div class="empty-state">
        <div class="empty-inner">
          <span class="empty-icon">{{ icon('check') }}</span>
          <p class="empty-title">Nothing is waiting</p>
          <p class="empty-text">When a member adds a mod, it lands here for an admin to approve. Approved requests go straight to the instance board.</p>
        </div>
      </div>
    </div>
    {% endfor %}
  </section>
  </div>

  <aside class="rail">
    <section class="panel">
      <div class="panel-head">
        <div>
          <h2 class="panel-title">Decided</h2>
          <p class="panel-sub">Last 15 decisions</p>
        </div>
      </div>
      <div class="panel-body" style="padding-top:8px;padding-bottom:8px">
        {% for request in decided %}
        <div class="decision-row">
          <span class="dot {% if request.status == 'approved' %}live{% else %}bad{% endif %}" style="margin-top:7px"></span>
          <div style="min-width:0">
            <p style="font-size:12px"><strong>{{ request.payload.name }}</strong> <span class="faint">· {{ request.instance_name }}</span></p>
            <p class="faint" style="font-size:10.5px;margin-top:2px">
              {{ request.status | capitalize }} by {{ request.decider_name or 'an admin' }} · {{ request.decided_at | relative }}
              {% if request.decision_note %} · “{{ request.decision_note | truncate(60) }}”{% endif %}
            </p>
          </div>
        </div>
        {% else %}
        <p class="faint" style="font-size:12px;padding:12px 0">No decisions yet.</p>
        {% endfor %}
      </div>
    </section>

    <section class="panel" style="margin-top:16px">
      <div class="panel-head">
        <div>
          <h2 class="panel-title">Pack import decisions</h2>
          <p class="panel-sub">Last 15 uploads</p>
        </div>
      </div>
      <div class="panel-body" style="padding-top:8px;padding-bottom:8px">
        {% for request in importDecided %}
        <div class="decision-row">
          <span class="dot {% if request.status == 'approved' %}live{% else %}bad{% endif %}" style="margin-top:7px"></span>
          <div style="min-width:0">
            <p style="font-size:12px"><strong>{% if request.mode == 'update' %}{{ request.instance_name }}{% else %}{{ request.pack_name or request.file_name }}{% endif %}</strong> <span class="faint">· {{ request.requester_name }}</span></p>
            <p class="faint" style="font-size:10.5px;margin-top:2px">{{ request.status | capitalize }} by {{ request.decider_name or 'an admin' }} · {{ request.decided_at | relative }}{% if request.decision_note %} · “{{ request.decision_note | truncate(60) }}”{% endif %}</p>
          </div>
        </div>
        {% else %}
        <p class="faint" style="font-size:12px;padding:12px 0">No pack decisions yet.</p>
        {% endfor %}
      </div>
    </section>

    <section class="panel" style="margin-top:16px">
      <div class="panel-head">
        <div>
          <h2 class="panel-title">Account decisions</h2>
          <p class="panel-sub">Last 15 role requests</p>
        </div>
      </div>
      <div class="panel-body" style="padding-top:8px;padding-bottom:8px">
        {% for request in roleDecided %}
        <div class="decision-row">
          <span class="dot {% if request.status == 'approved' %}live{% else %}bad{% endif %}" style="margin-top:7px"></span>
          <div style="min-width:0">
            <p style="font-size:12px"><strong>{{ request.requester_name }}</strong> <span class="faint">· admin role</span></p>
            <p class="faint" style="font-size:10.5px;margin-top:2px">{{ request.status | capitalize }} by {{ request.decider_name or 'an admin' }} · {{ request.decided_at | relative }}{% if request.decision_note %} · “{{ request.decision_note | truncate(60) }}”{% endif %}</p>
          </div>
        </div>
        {% else %}
        <p class="faint" style="font-size:12px;padding:12px 0">No account decisions yet.</p>
        {% endfor %}
      </div>
    </section>

    <section class="panel" style="margin-top:16px">
      <div class="panel-head">
        <div>
          <h2 class="panel-title">Who can do what</h2>
          <p class="panel-sub">Roles in this instance</p>
        </div>
      </div>
      <div class="panel-body">
        <div class="kv">
          <div class="kv-row"><span class="kv-label">Admin</span><span class="kv-value">Imports, edits, deletes, checks, approves and manages users.</span></div>
          <div class="kv-row"><span class="kv-label">Member</span><span class="kv-value">Reads the board, requests mods and submits .mrpack imports. Both wait here.</span></div>
        </div>
      </div>
    </section>
  </aside>
</div>
{% endblock %}
