{% extends "layout.njk" %}
{% from "partials/icon.njk" import icon %}
{% from "partials/avatar.njk" import avatar %}

{% block content %}
<div class="page-head">
  <div class="page-head-main">
    <p class="eyebrow">Access</p>
    <h1 class="page-title">Users</h1>
    <p class="page-sub">Admins manage instances and approvals. Members read the board, request mods and submit pack imports for review. Accounts are local to ModWatch.</p>
  </div>
  <div class="page-actions">
    <a class="btn primary" href="/users/new">{{ icon('plus') }} New user</a>
  </div>
</div>

<section class="panel">
  <div class="table-wrap">
    <table class="board">
      <thead>
        <tr>
          <th>User</th>
          <th>Role</th>
          <th>Status</th>
          <th class="n hide-sm">Mods added</th>
          <th class="n hide-sm">Requests</th>
          <th class="hide-sm">Last sign-in</th>
          <th aria-label="Actions"></th>
        </tr>
      </thead>
      <tbody>
        {% for user in users %}
        <tr>
          <td>
            <div class="user-cell">
              {{ avatar(user) }}
              <span class="mod-copy">
                <span class="mod-name">{{ user.name }}</span>
                <span class="mod-file">{{ user.email }}</span>
              </span>
            </div>
          </td>
          <td><span class="role-tag {% if user.role == 'admin' %}admin{% endif %}">{{ user.role | roleLabel }}</span></td>
          <td>
            {% set state = user.status | userStatus %}
            <span class="pill {{ state.tone }}"><span class="dot"></span>{{ state.label }}</span>
          </td>
          <td class="n hide-sm">{{ user.mods_added }}</td>
          <td class="n hide-sm">{{ user.requests }}</td>
          <td class="faint hide-sm nowrap">{{ user.last_login_at | relative }}</td>
          <td class="n">
            <span class="row" style="gap:2px;justify-content:flex-end">
              <a class="icon-btn" href="/users/{{ user.id }}/edit" aria-label="Edit {{ user.name }}" title="Edit {{ user.name }}">{{ icon('pencil') }}</a>
              {% set cannotDelete = user.id == currentUser.id or (user.role == 'admin' and user.status == 'active' and activeAdminCount <= 1) %}
              {% if cannotDelete %}
              <button class="icon-btn" type="button" disabled aria-label="Cannot delete {{ user.name }}" title="{% if user.id == currentUser.id %}You cannot delete your own account{% else %}Keep at least one active admin{% endif %}">{{ icon('trash') }}</button>
              {% else %}
              <form method="post" action="/users/{{ user.id }}/delete"
                data-confirm-title="Delete user?"
                data-confirm-label="Delete"
                data-confirm="Delete {{ user.name }} ({{ user.email }})? Their account, notifications and pending requests are removed, and any active session is signed out. This cannot be undone.">
                {% include "partials/csrf.njk" %}
                <button class="icon-btn danger" type="submit" aria-label="Delete {{ user.name }}" title="Delete {{ user.name }}">{{ icon('trash') }}</button>
              </form>
              {% endif %}
            </span>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</section>

<section class="panel section-gap">
  <div class="panel-head">
    <div>
      <h2 class="panel-title">Roles</h2>
      <p class="panel-sub">What each role can do</p>
    </div>
  </div>
  <div class="panel-body">
    <div class="grid">
      <div class="span-6">
        <p class="cell-main">Admin</p>
        <p class="faint" style="margin-top:5px;font-size:11.5px;line-height:1.6">Creates and edits instances, imports packs, resolves unknown files, runs checks, changes settings, approves requests and manages users. The first admin comes from ADMIN_EMAIL in .env.</p>
      </div>
      <div class="span-6">
        <p class="cell-main">Member</p>
        <p class="faint" style="margin-top:5px;font-size:11.5px;line-height:1.6">Sees every instance board and notification. Can request a mod and submit a .mrpack import; both wait for an admin. Cannot delete users, edit instances or change settings.</p>
      </div>
    </div>
  </div>
</section>
{% endblock %}
