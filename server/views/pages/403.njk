{% extends "layout.njk" %}
{% from "partials/icon.njk" import icon %}
{% from "partials/mark.njk" import mark %}

{% block content %}
<div class="state-page">
  <div class="state-inner">
    <div class="state-mark">{{ mark(44) }}</div>
    <p class="state-code">403 · ADMINS ONLY</p>
    <h1 class="state-title">{{ title or 'Admins only' }}</h1>
    <p class="state-text">{{ message or 'This page is only available to the instance owner.' }}</p>
    <div class="state-actions">
      <a class="btn primary" href="/">Back to overview</a>
      <a class="btn" href="/instances">Instances</a>
    </div>
  </div>
</div>
{% endblock %}
