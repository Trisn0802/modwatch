{% extends "layout.njk" %}
{% from "partials/icon.njk" import icon %}

{% block content %}
<a class="backlink" href="/instances/{{ instance.id }}">{{ icon('arrow-left') }} {{ instance.name }}</a>

<div class="page-head">
  <div class="page-head-main">
    <p class="eyebrow">Add a project</p>
    <h1 class="page-title">Find the {{ kindLabel | lower }}</h1>
    <p class="page-sub">{% if kind == 'mod' %}Modrinth results are filtered to {{ instance.mc_version }} {{ instance.loader | loaderLabel }}.{% else %}Results are filtered to Minecraft {{ instance.mc_version }}; the loader does not apply to a {{ kindLabel | lower }}.{% endif %} GitHub is searched broadly; pick the matching version before adding. CurseForge URLs resolve without a key.</p>
    <div style="margin-top:12px">
      <div class="scope compact">
        <span class="scope-cell"><span class="scope-label">Minecraft</span><strong>{{ instance.mc_version }}</strong></span>
        <span class="scope-cell"><span class="scope-label">Loader</span><strong>{{ instance.loader | loaderLabel }}</strong></span>
      </div>
    </div>
  </div>
</div>

<nav class="tabs kind-tabs" aria-label="Project kind">
  {% for value in kindOptions %}
  <a class="tab" href="/instances/{{ instance.id }}/mods/new?kind={{ value }}{% if sourceFilter != 'all' %}&source={{ sourceFilter }}{% endif %}{% if q %}&q={{ q | urlencode }}{% endif %}" {% if kind == value %}aria-current="page"{% endif %}>{{ value | kindPlural }}</a>
  {% endfor %}
</nav>

<div class="layout-main">
  <section class="panel">
    <form class="toolbar" method="get" action="/instances/{{ instance.id }}/mods/new" data-realtime-search="#mod-add-results">
      <input type="hidden" name="source" value="{{ sourceFilter }}">
      <input type="hidden" name="kind" value="{{ kind }}">
      <div class="toolbar-left" style="flex:1">
        <label class="search-field" style="flex:1">
          {{ icon('search') }}
          <span class="sr-only">Search projects</span>
          <input type="search" name="q" value="{{ q }}" placeholder="{% if kind == 'mod' %}JEI, Create, Sophisticated Backpacks…{% elif kind == 'shader' %}Complementary, BSL, Rethinking Voxels…{% elif kind == 'resourcepack' %}Fresh Animations, Stay True…{% else %}Terralith, Incendium…{% endif %}" autocomplete="off" autofocus>
        </label>
        <button class="btn" type="submit">Search</button>
        {% if q %}<a class="link-btn" href="/instances/{{ instance.id }}/mods/new">Clear</a>{% endif %}
      </div>
    </form>

    <nav class="tabs source-tabs" aria-label="Search source">
      <a class="tab" href="/instances/{{ instance.id }}/mods/new?source=all&kind={{ kind }}{% if q %}&q={{ q | urlencode }}{% endif %}" {% if sourceFilter == 'all' %}aria-current="page"{% endif %}>All</a>
      <a class="tab" href="/instances/{{ instance.id }}/mods/new?source=modrinth&kind={{ kind }}{% if q %}&q={{ q | urlencode }}{% endif %}" {% if sourceFilter == 'modrinth' %}aria-current="page"{% endif %}>Modrinth</a>
      <a class="tab" href="/instances/{{ instance.id }}/mods/new?source=curseforge&kind={{ kind }}{% if q %}&q={{ q | urlencode }}{% endif %}" {% if sourceFilter == 'curseforge' %}aria-current="page"{% endif %}>CurseForge{% if not env.curseforgeReady %} <span class="count">URL</span>{% endif %}</a>
      <a class="tab" href="/instances/{{ instance.id }}/mods/new?source=github&kind={{ kind }}{% if q %}&q={{ q | urlencode }}{% endif %}" {% if sourceFilter == 'github' %}aria-current="page"{% endif %}>GitHub</a>
    </nav>

    <div class="search-live" data-search-live hidden>
      <span class="dot busy"></span><span data-search-live-text>Searching Modrinth and GitHub…</span>
    </div>
    <div id="mod-add-results" aria-live="polite">
      {% include "partials/mod-add-results.njk" %}
    </div>
  </section>

  <aside class="rail">
    <section class="panel" id="add-by-url" style="margin-bottom:16px">
      <div class="panel-head">
        <div>
          <h2 class="panel-title">Add by URL</h2>
          <p class="panel-sub">Works for CurseForge without a key</p>
        </div>
      </div>
      <div class="panel-body">
        <form class="form" method="get" action="/instances/{{ instance.id }}/mods/resolve"
          data-progress-nav
          data-progress-title="Resolving the project"
          data-progress-message="Checking the URL against Modrinth, CurseForge or GitHub, then loading versions for this instance."
          data-progress-steps="Read the project URL|Ask the source|Find the project|Load versions|Open the version list"
          data-progress-done-title="Project found"
          data-progress-done-label="Open versions">
          <input type="hidden" name="kind" value="{{ kind }}">
          <label class="sr-only" for="add-url">Project URL</label>
          <input class="input" id="add-url" name="url" type="url" placeholder="https://www.curseforge.com/minecraft/mc-mods/…" required>
          <p class="hint">ModWatch resolves the project, then opens the version list for this instance.</p>
          <button class="btn" type="submit">{{ icon('link') }} Resolve and choose version</button>
        </form>
      </div>
    </section>

    {% if manual %}
    <section class="panel">
      <div class="panel-head">
        <div>
          <h2 class="panel-title">Manual entry</h2>
          <p class="panel-sub">No project page? Track the jar anyway</p>
        </div>
        <a class="link-btn" href="/instances/{{ instance.id }}/mods/new?kind={{ kind }}">Back to search</a>
      </div>
      <div class="panel-body">
        <form class="form" method="post" action="/instances/{{ instance.id }}/mods">
          {% include "partials/csrf.njk" %}
          <input type="hidden" name="source" value="manual">
          <div class="field">
            <label for="manual-name">Project name</label>
            <input id="manual-name" name="name" type="text" placeholder="Private server patch" required>
          </div>
          <div class="field">
            <label for="manual-kind">Kind</label>
            <select id="manual-kind" name="kind">
              {% for value in kindOptions %}<option value="{{ value }}" {% if kind == value %}selected{% endif %}>{{ value | kindPlural }}</option>{% endfor %}
            </select>
          </div>
          <div class="field">
            <label for="manual-version">Installed version</label>
            <input id="manual-version" name="installed_version" type="text" placeholder="1.4.2">
          </div>
          <div class="field">
            <label for="manual-url">Project page</label>
            <input id="manual-url" name="project_url" type="url" placeholder="https://…">
            <p class="hint">A Modrinth, CurseForge or GitHub project URL is detected automatically and opens version selection. Leave it empty only for private jars.</p>
          </div>
          <div class="form-grid">
            <div class="field">
              <label for="manual-side">Side</label>
              <select id="manual-side" name="side">
                <option value="both">Client + server</option>
                <option value="client">Client only</option>
                <option value="server">Server only</option>
              </select>
            </div>
            <div class="field">
              <label for="manual-channel">Channel policy</label>
              <select id="manual-channel" name="channel_policy">
                {% for value, label in channelOptions %}
                <option value="{{ value }}">{{ label }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <button class="btn primary" type="submit">{{ icon('plus') }} Add manual project</button>
        </form>
      </div>
    </section>
    {% else %}
    <section class="panel">
      <div class="panel-head">
        <div>
          <h2 class="panel-title">Not on a source?</h2>
          <p class="panel-sub">Keep it visible without a lookup</p>
        </div>
      </div>
      <div class="panel-body">
        <p class="faint" style="font-size:11.5px;line-height:1.6">Private jars, resource packs and one-off patches have no project page. A manual entry keeps the file, its hash and its version on the board with no automatic update check.</p>
        <a class="btn" style="margin-top:14px" href="/instances/{{ instance.id }}/mods/new?manual=1&kind={{ kind }}">{{ icon('plus') }} Add manually</a>
      </div>
    </section>
    {% endif %}

    <section class="panel" style="margin-top:16px">
      <div class="panel-head">
        <div>
          <h2 class="panel-title">Source order</h2>
          <p class="panel-sub">What the search uses</p>
        </div>
      </div>
      <div class="panel-body">
        <div class="env-list">
          <div class="env-row"><span class="env-name">Modrinth</span><span class="env-state"><span class="dot live"></span>Always on</span></div>
          <div class="env-row"><span class="env-name">CurseForge</span><span class="env-state"><span class="dot {% if env.curseforgeReady %}live{% endif %}"></span>{% if env.curseforgeReady %}Search + URL{% else %}URL only · key needed for search{% endif %}</span></div>
          <div class="env-row"><span class="env-name">GitHub</span><span class="env-state"><span class="dot live"></span>Search + releases{% if env.githubReady %} · token{% endif %}</span></div>
        </div>
      </div>
    </section>
  </aside>
</div>
{% endblock %}
