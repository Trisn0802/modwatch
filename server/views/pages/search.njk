{% extends "layout.njk" %}
{% from "partials/icon.njk" import icon %}
{% from "partials/kind-badge.njk" import kindBadge %}

{% block content %}
<div class="page-head">
  <div class="page-head-main">
    <p class="eyebrow">Search</p>
    <h1 class="page-title">Search ModWatch</h1>
    <p class="page-sub">Find a project by name, file or creator, or jump to an instance by pack name and Minecraft version.</p>
  </div>
</div>

<div class="search-hero">
  <form class="big-search" action="/search" method="get" role="search">
    <label class="sr-only" for="search-q">Search</label>
    <input id="search-q" name="q" type="search" value="{{ q }}" placeholder="Create, jei-1.20.1, Complementary, Gugu Gaga…" autofocus>
    <label class="sr-only" for="search-kind">Project kind</label>
    <select id="search-kind" name="kind" class="select">
      <option value="">All kinds</option>
      {% for option in kindOptions %}<option value="{{ option.value }}" {% if kind == option.value %}selected{% endif %}>{{ option.label }}</option>{% endfor %}
    </select>
    <button class="btn primary" type="submit">{{ icon('search') }} Search</button>
  </form>
</div>

{% if q %}
<div class="result-group">
  <div class="page-head" style="margin-bottom:8px">
    <div><h2 class="panel-title">Projects <span class="faint" style="font-weight:400">· {{ mods.length }}</span></h2></div>
  </div>
  <section class="panel">
    {% for mod in mods %}
    {% set meta = mod.status | statusMeta %}
    <a class="result-row" href="/mods/{{ mod.id }}">
      {% set art = mod | modIcon %}
      <span class="result-icon">
        {% if art %}
        <img src="{{ art }}" alt="" width="32" height="32" loading="lazy" data-fallback="{{ mod.name | initials }}">
        {% else %}
        {{ mod.name | initials }}
        {% endif %}
      </span>
      <span class="result-main">
        <span class="result-name">{{ mod.name }}</span>
        <span class="result-meta">
          {{ kindBadge(mod.kind) }}
          {{ mod.instance_name }} · {{ mod.file_name or mod.installed_version }}{% if mod.creator_name %} · {{ mod.creator_name }}{% endif %}
        </span>
      </span>
      <span class="pill {{ meta.tone }}"><span class="dot"></span>{{ meta.label }}</span>
      {{ icon('chevron-right') }}
    </a>
    {% else %}
    <div class="empty-state" style="border:0"><div class="empty-inner"><p class="empty-title">No mod matched</p><p class="empty-text">Try part of the project name or the jar file name.</p></div></div>
    {% endfor %}
  </section>
</div>

{% if instances.length %}
<div class="result-group">
  <div class="page-head" style="margin-bottom:8px">
    <div><h2 class="panel-title">Instances <span class="faint" style="font-weight:400">· {{ instances.length }}</span></h2></div>
  </div>
  <section class="panel">
    {% for item in instances %}
    <a class="result-row" href="/instances/{{ item.id }}">
      <span class="result-icon">
        {% if item.image_path %}
        <img src="/uploads/{{ item.image_path }}" alt="" width="32" height="32" loading="lazy" data-fallback="{{ item.name | initials }}">
        {% else %}
        {{ item.name | initials }}
        {% endif %}
      </span>
      <span class="result-main">
        <span class="result-name">{{ item.name }}</span>
        <span class="result-meta">{{ item.mc_version }} · {{ item.loader | loaderLabel }}{% if item.loader_version %} {{ item.loader_version }}{% endif %}{% if item.pack_version %} · pack {{ item.pack_version }}{% endif %}</span>
      </span>
      {{ icon('chevron-right') }}
    </a>
    {% endfor %}
  </section>
</div>
{% endif %}

{% else %}
<section class="panel">
  <div class="panel-body">
    <div class="empty-state">
      <div class="empty-inner">
        <span class="empty-icon">{{ icon('search') }}</span>
        <p class="empty-title">Type something to search</p>
        <p class="empty-text">The search covers every instance you can see. Press <kbd>/</kbd> anywhere to jump to the topbar field.</p>
      </div>
    </div>
  </div>
</section>
{% endif %}
{% endblock %}
