{% extends "share-layout.njk" %}
{% from "partials/icon.njk" import icon %}
{% from "partials/kind-badge.njk" import kindBadge %}
{% from "partials/source-icon.njk" import sourceIcon %}

{% block content %}
<section class="share-hero">
  <div class="share-hero-main">
    <p class="eyebrow"><span class="dot live"></span> Shared modpack</p>
    <div class="share-title-row">
      {% if instance.image_path %}
      <img class="instance-photo" src="/uploads/{{ instance.image_path }}" alt="">
      {% else %}
      <span class="instance-mark xl">{{ instance.name | initials }}</span>
      {% endif %}
      <div>
        <h1 class="share-title">{{ instance.pack_name or instance.name }}</h1>
        <p class="share-sub">{{ overview.stats.mods }} tracked projects · {{ instance.mc_version }} · {{ instance.loader | loaderLabel }}{% if instance.loader_version %} {{ instance.loader_version }}{% endif %}</p>
      </div>
    </div>
    <div class="share-actions">
      <a class="btn primary" href="/s/{{ instance.share_token }}/export">{{ icon('download') }} Download .mrpack</a>
      <button class="btn" type="button" data-copy="{{ shareUrl }}">{{ icon('link') }} Copy share link</button>
    </div>
    <p class="share-note">The .mrpack is generated from the tracked versions. Import it in Modrinth App, Prism, ATLauncher or any launcher that accepts .mrpack. The .zip keeps the raw files, grouped by kind.</p>
  </div>
  <aside class="share-summary">
    <div class="share-summary-row">
      <span>Updates waiting</span>
      <strong class="{% if overview.stats.updates %}accent{% endif %}">{{ overview.stats.updates }}</strong>
    </div>
    <div class="share-summary-row">
      <span>Tracked projects</span>
      <strong>{{ overview.stats.mods }}</strong>
    </div>
    <div class="share-summary-row">
      <span>Disabled files</span>
      <strong>{{ overview.stats.disabled }}</strong>
    </div>
    <div class="share-summary-row">
      <span>Pack version</span>
      <strong>{{ instance.pack_version or '—' }}</strong>
    </div>
    <div class="share-summary-row">
      <span>Last check</span>
      <strong>{{ instance.last_checked_at | relative }}</strong>
    </div>
  </aside>
</section>

<section class="panel share-panel share-mods" data-facet-filter data-facet-target="#share-mod-table" data-facet-empty="#share-filter-empty" data-facet-noun="{% if view == 'updates' %}update{% else %}project{% endif %}">
  <div class="panel-head">
    <div>
      <h2 class="panel-title">{% if view == 'updates' %}Update table{% else %}All projects{% endif %}</h2>
      <p class="panel-sub">{% if view == 'updates' %}{{ overview.stats.updates }} project{% if overview.stats.updates != 1 %}s{% endif %} with a newer allowed version{% else %}Every tracked project in this pack, including disabled files{% endif %}</p>
    </div>
    <nav class="share-tabs" aria-label="Project table view">
      <a href="/s/{{ instance.share_token }}?view=all" {% if view != 'updates' %}aria-current="page"{% endif %}>All projects</a>
      <a href="/s/{{ instance.share_token }}?view=updates" {% if view == 'updates' %}aria-current="page"{% endif %}>Updates</a>
    </nav>
  </div>
  <div class="share-mod-toolbar">
    <label class="search-field">
      {{ icon('search') }}
      <span class="sr-only">Filter shared projects</span>
      <input type="search" placeholder="Filter by project, version, creator or source" autocomplete="off" data-facet-search>
    </label>
    <details class="pop filter-pop">
      <summary class="btn sm">{{ icon('filter') }} Filters{% if overview.stats.mods %} <span class="filter-count" data-facet-count-badge hidden></span>{% endif %}</summary>
      <div class="pop-panel filter-panel">
        <div class="filter-group">
          <p class="filter-group-title">Kind</p>
          {% for option in kindOptions %}
          <label class="filter-option">
            <input type="checkbox" data-facet-kind value="{{ option.value }}">
            <span>{{ option.label }}</span>
            <span class="count">{{ option.count }}</span>
          </label>
          {% endfor %}
        </div>
        <div class="filter-group">
          <p class="filter-group-title">Source</p>
          {% for option in sourceOptions %}
          <label class="filter-option">
            <input type="checkbox" data-facet-source value="{{ option.value }}">
            <span>{{ option.label }}</span>
            <span class="count">{{ option.count }}</span>
          </label>
          {% endfor %}
        </div>
        <div class="filter-actions">
          <button class="btn sm ghost" type="button" data-facet-clear>Clear</button>
        </div>
      </div>
    </details>
    <span class="count-note" data-facet-count>{% if view == 'updates' %}{{ overview.stats.updates }} update{% if overview.stats.updates != 1 %}s{% endif %}{% else %}{{ overview.stats.mods }} projects{% endif %}</span>
    <label class="check zip-check" title="Select the projects visible on this page"><input type="checkbox" data-share-select-all> Select page</label>
    <button class="btn sm download" type="submit" form="share-zip-form" data-share-zip-submit disabled title="Download the selected files as a zip, grouped by kind">{{ icon('download') }} <span data-share-zip-label>Download selected</span></button>
    <button class="btn sm download" type="submit" form="share-zip-form" name="all" value="1" title="Download every file in this pack as a zip, grouped by kind">{{ icon('download') }} Download all (.zip)</button>
  </div>
  <div class="filter-chips" data-facet-chips hidden></div>

  <form id="share-zip-form" class="zip-form" method="post" action="/s/{{ instance.share_token }}/download-zip">
    {% include "partials/csrf.njk" %}
  </form>

  <div class="table-wrap share-mod-wrap">
    <table class="board share-mod-table" id="share-mod-table">
      <thead>
        <tr>
          <th>Project</th>
          <th>Version</th>
          <th class="hide-sm">Source</th>
          <th class="hide-sm">Side</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        {% for mod in overview.mods %}
        {% if view != 'updates' or mod.status == 'update_available' %}
        {% set shown = 'frozen' if mod.frozen_at else ('snoozed' if (mod.snoozed_version_id and mod.snoozed_version_id == mod.latest_version_id and mod.status == 'up_to_date') else mod.status) %}
        {% set meta = shown | statusMeta %}
        <tr data-row data-kind="{{ mod.kind }}" data-source="{{ mod.source }}" class="{% if mod.disabled %}is-disabled{% endif %}">
          <td>
            <div class="mod-cell">
              <input class="mod-select" type="checkbox" name="mod_ids" value="{{ mod.id }}" form="share-zip-form" aria-label="Select {{ mod.name }}">
              {% set art = mod | modIcon %}
              {% if art %}
              <img class="mod-icon" src="{{ art }}" alt="" width="30" height="30" loading="lazy" data-fallback="{{ mod.name | initials }}">
              {% else %}
              <span class="mod-icon fallback">{{ mod.name | initials }}</span>
              {% endif %}
              <span class="mod-copy">
                <span class="mod-name">{{ mod.name }}</span>
                <span class="mod-file">{{ mod.file_name or mod.installed_version or 'No file recorded' }}</span>
                <span class="mod-meta-line">
                  {{ kindBadge(mod.kind) }}
                  {% if mod.creator_name %}
                  <span class="creator-line">
                    {% if mod.creator_avatar_url %}<img class="author-avatar" src="{{ mod.creator_avatar_url }}" alt="" loading="lazy">{% endif %}
                    {% if mod.creator_url %}<a href="{{ mod.creator_url }}" target="_blank" rel="noopener noreferrer">{{ mod.creator_name }}</a>{% else %}{{ mod.creator_name }}{% endif %}
                  </span>
                  {% endif %}
                </span>
              </span>
            </div>
          </td>
          <td>
            {% if mod.status == 'update_available' %}
            <span class="vshift"><span class="from">{{ mod.installed_version }}</span><span class="arrow">{{ icon('arrow-right') }}</span><span class="to">{{ mod.latest_version }}</span></span>
            {% else %}
            <span class="vshift same"><span class="to">{{ mod.installed_version or '—' }}</span></span>
            {% endif %}
          </td>
          <td class="hide-sm">{% set src = mod.source | sourceMeta %}<span class="source-label {{ mod.source }}">{{ sourceIcon(mod.source) }}{{ src.label }}</span></td>
          <td class="hide-sm faint">{{ mod.side | sideLabel }}</td>
          <td>
            <span class="row" style="gap:5px;flex-wrap:wrap">
              <span class="pill {{ meta.tone }}"><span class="dot"></span>{{ meta.label }}</span>
              {% if mod.disabled %}<span class="pill muted">Disabled</span>{% endif %}
            </span>
          </td>
        </tr>
        {% endif %}
        {% endfor %}
      </tbody>
    </table>
  </div>
  <div class="panel-body" id="share-filter-empty" hidden>
    <p class="faint" style="font-size:12px;text-align:center">No project matches those filters.</p>
  </div>
</section>

<section class="share-meta">
  <span>Shared with ModWatch</span>
  <span class="sep"></span>
  <span>{{ instance.pack_version or 'Pack version not set' }}</span>
  <span class="sep"></span>
  <span>Snapshot {{ instance.last_checked_at | relative }}</span>
</section>
{% endblock %}
