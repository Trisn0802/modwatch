{% extends "share-layout.njk" %}
{% from "partials/icon.njk" import icon %}

{% block content %}
<section class="share-hero">
  <div class="share-hero-main">
    <p class="eyebrow"><span class="dot live"></span> Shared modpack</p>
    <div class="share-title-row">
      {% if instance.image_path %}
      <img class="instance-photo" src="/uploads/{{ instance.image_path }}" alt="">
      {% else %}
      <span class="instance-mark xl">{{ instance.name | initials }}</span>
      {% endif %}
      <div>
        <h1 class="share-title">{{ instance.pack_name or instance.name }}</h1>
        <p class="share-sub">{{ overview.stats.mods }} tracked mods · {{ instance.mc_version }} · {{ instance.loader | loaderLabel }}{% if instance.loader_version %} {{ instance.loader_version }}{% endif %}</p>
      </div>
    </div>
    <div class="share-actions">
      <a class="btn primary" href="/s/{{ instance.share_token }}/export">{{ icon('download') }} Download .mrpack</a>
      <button class="btn" type="button" data-copy="{{ shareUrl }}">{{ icon('link') }} Copy share link</button>
    </div>
    <p class="share-note">The download is generated from the tracked versions. Import it in Modrinth App, Prism, ATLauncher or any launcher that accepts .mrpack.</p>
  </div>
  <aside class="share-summary">
    <div class="share-summary-row">
      <span>Updates waiting</span>
      <strong class="{% if overview.stats.updates %}accent{% endif %}">{{ overview.stats.updates }}</strong>
    </div>
    <div class="share-summary-row">
      <span>Tracked mods</span>
      <strong>{{ overview.stats.mods }}</strong>
    </div>
    <div class="share-summary-row">
      <span>Disabled files</span>
      <strong>{{ overview.stats.disabled }}</strong>
    </div>
    <div class="share-summary-row">
      <span>Pack version</span>
      <strong>{{ instance.pack_version or '—' }}</strong>
    </div>
    <div class="share-summary-row">
      <span>Last check</span>
      <strong>{{ instance.last_checked_at | relative }}</strong>
    </div>
  </aside>
</section>

