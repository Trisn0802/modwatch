{% extends "layout.njk" %}
{% from "partials/icon.njk" import icon %}

{% block content %}
<div class="import-page">
<a class="backlink" href="/instances">{{ icon('arrow-left') }} Instances</a>

<div class="page-head">
  <div class="page-head-main">
    <p class="eyebrow">Import</p>
    <h1 class="page-title">Import a .mrpack</h1>
    <p class="page-sub">ModWatch reads the pack index, hashes every mod jar, and matches each one against Modrinth. Nothing is written until you review the preview.</p>
  </div>
</div>

{% if error %}
<div class="error-box" role="alert">{{ icon('alert') }}<span>{{ error }}</span></div>
{% endif %}

<div class="layout-main">
  <section class="panel">
    <div class="panel-head">
      <div>
        <h2 class="panel-title">Choose the pack</h2>
        <p class="panel-sub">A .mrpack exported by Modrinth App, Prism or ATLauncher</p>
      </div>
    </div>
    <div class="panel-body">
      <form class="form" id="import-upload-form" method="post" action="upload" enctype="multipart/form-data"
        data-progress-upload
        data-progress-title="Reading the pack"
        data-progress-message="Uploading the archive, then hashing every project file and matching it on Modrinth."
        data-progress-steps="Upload the .mrpack|Read modrinth.index.json|Hash project files|Match hashes on Modrinth|Build the folder tree|Open the preview"
        data-progress-done-title="Preview ready"
        data-progress-done-label="Open the preview">
        {% include "partials/csrf.njk" %}
        <div class="dropzone" data-dropzone>
          <input type="file" name="pack" accept=".mrpack,application/x-zip-compressed,application/zip" required aria-label="Modpack file">
          <span class="dropzone-icon">{{ icon('upload') }}</span>
          <p class="dropzone-title">Drop the .mrpack here or browse</p>
          <p class="dropzone-name" data-dropzone-name>No file chosen yet</p>
          <p class="dropzone-note">Zip archive · up to {{ maxUploadMb }} MB</p>
        </div>
        <div class="form-actions">
          <button class="btn primary" type="submit">{{ icon('upload') }} Upload and review</button>
          <a class="btn ghost" href="/instances">Cancel</a>
        </div>
      </form>
    </div>
  </section>

  <aside class="rail">
    <section class="panel">
      <div class="panel-head">
        <div>
          <h2 class="panel-title">What happens next</h2>
          <p class="panel-sub">Review before write</p>
        </div>
      </div>
      <div class="panel-body">
        <div class="steps">
          <div class="step">
            <span class="step-num">1</span>
            <div><strong>Read the index</strong><p>Minecraft version, Forge, Fabric, NeoForge or Quilt, and the pack version come from <code>modrinth.index.json</code>.</p></div>
          </div>
          <div class="step">
            <span class="step-num">2</span>
            <div><strong>Match every hash</strong><p>Modrinth's hash endpoint identifies the exact version. Unmatched jars keep their file hash and jar metadata.</p></div>
          </div>
          <div class="step">
            <span class="step-num">3</span>
            <div><strong>Review, then commit</strong><p>The preview lists identified mods and files that need a decision. Confirming writes the instance in one transaction.</p></div>
          </div>
        </div>
      </div>
    </section>

    <section class="panel" style="margin-top:16px">
      <div class="panel-head">
        <div>
          <h2 class="panel-title">Scope carried in</h2>
          <p class="panel-sub">The pack's own facts win</p>
        </div>
      </div>
      <div class="panel-body">
        <p class="faint" style="font-size:11.5px;line-height:1.6">The imported instance takes the pack's Minecraft version and loader. If you import an update into an existing instance, those scope fields move to the new pack's values and the next check follows them.</p>
      </div>
    </section>
  </aside>
</div>
</div>
{% endblock %}
