{% from "partials/mark.njk" import mark %}
<!doctype html>
<html lang="en" data-theme="oled" data-theme-mode="oled">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}{{ title or 'Sign in' }}{% endblock %} · ModWatch</title>
  <meta name="description" content="ModWatch tracks Minecraft mods across modpacks and reports updates for the exact Minecraft version and loader you run.">
  <meta name="theme-color" content="#000000">
  <link rel="icon" href="/assets/img/favicon.ico" sizes="any">
  <link rel="icon" type="image/svg+xml" href="/assets/img/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicon-32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/img/favicon-16.png">
  <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
  <link rel="manifest" href="/assets/site.webmanifest">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="ModWatch">
  <meta property="og:title" content="Sign in · ModWatch">
  <meta property="og:description" content="Self-hosted Minecraft modpack update tracker for Forge, Fabric, NeoForge and Quilt.">
  <meta property="og:url" content="{{ baseUrl }}/login">
  <meta property="og:image" content="{{ baseUrl }}/assets/img/og-image.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <script src="/assets/js/theme.js?v={{ assetVersion }}"></script>
  <link rel="stylesheet" href="/assets/css/modwatch.css?v={{ assetVersion }}">
</head>
<body class="auth-body" data-page="{{ page or 'login' }}">
<div class="auth">
  <section class="auth-brand" aria-label="About ModWatch">
    <a class="brand auth-wordmark" href="/login" aria-label="ModWatch">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 28 28" fill="none">
          <circle cx="14" cy="14" r="10.2" stroke="currentColor" stroke-width="1.6" stroke-dasharray="46 14" stroke-linecap="round"/>
          <path d="M14 7.4l5.8 3v6.2L14 19.6l-5.8-3v-6.2z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
          <circle cx="14" cy="13.5" r="2.1" fill="var(--brand)"/>
        </svg>
      </span>
      <span class="brand-name">ModWatch</span>
    </a>
    <div class="auth-copy">
      <h1>Know what is out of date before the pack starts.</h1>
      <p>ModWatch reads the mods inside a Minecraft modpack and checks each one against the exact Minecraft version and loader that pack runs. Modrinth first, then GitHub, with CurseForge when a key is configured.</p>
    </div>
    <div class="auth-scope">
      <span class="scope-label">The comparison that matters</span>
      <div class="auth-scope-row">
        <span class="scope-cell"><span>Minecraft</span><strong>1.20.1</strong></span>
        <span class="scope-cell"><span>Loader</span><strong>Forge 47.4.28</strong></span>
        <span class="scope-cell"><span>Channel</span><strong>Release only</strong></span>
      </div>
      <p>A Fabric 1.21 build never counts for a Forge 1.20.1 pack. That is the whole point.</p>
    </div>
    <p class="auth-foot">Self-hosted · v{{ appVersion }}</p>
  </section>
  <section class="auth-panel">
    <a class="brand auth-mobile-brand" href="/login" aria-label="ModWatch">
      <span class="brand-mark">{{ mark(28) }}</span>
      <span class="brand-name">ModWatch</span>
    </a>
    <div class="auth-theme" id="auth-theme"></div>
    <div class="auth-form-wrap">
      {% include "partials/flash.njk" %}
      {% block content %}{% endblock %}
    </div>
  </section>
</div>
<script src="/assets/js/ui.js?v={{ assetVersion }}"></script>
</body>
</html>
