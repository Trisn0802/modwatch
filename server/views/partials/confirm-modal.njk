{% from "partials/icon.njk" import icon %}
<dialog class="confirm-modal" id="confirm-modal" aria-labelledby="confirm-title">
  <div class="dialog-head">
    <div>
      <p class="confirm-kicker" id="confirm-kicker">Confirm</p>
      <h2 class="dialog-title" id="confirm-title">Confirm action</h2>
    </div>
    <button class="icon-btn" type="button" id="confirm-close" aria-label="Close confirmation">{{ icon('close') }}</button>
  </div>
  <div class="dialog-body confirm-body">
    <p id="confirm-message"></p>
    <p class="confirm-note" id="confirm-note" hidden></p>
    <ul class="confirm-list" id="confirm-list" hidden></ul>
    <p class="confirm-error" id="confirm-error" role="alert" hidden></p>
  </div>
  <div class="dialog-foot">
    <button class="btn" type="button" id="confirm-cancel">Cancel</button>
    <button class="btn primary" type="button" id="confirm-ok">Continue</button>
  </div>
</dialog>
