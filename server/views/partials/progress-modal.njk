{% from "partials/icon.njk" import icon %}
<dialog class="progress-modal" id="progress-modal" aria-labelledby="progress-title" aria-busy="true" aria-modal="true" closedby="none" data-static>
  <div class="progress-body">
    <span class="progress-spinner" aria-hidden="true"></span>
    <span class="progress-check" id="progress-check" aria-hidden="true" hidden>{{ icon('check', 26) }}</span>
    <p class="confirm-kicker" id="progress-kicker">Working</p>
    <h2 class="dialog-title" id="progress-title">Working…</h2>
    <p class="progress-message" id="progress-message">Keep this tab open while ModWatch finishes.</p>
    <div class="progress-meter" id="progress-meter" hidden><span id="progress-meter-fill"></span></div>
    <ul class="progress-steps" id="progress-steps"></ul>
    <p class="confirm-error" id="progress-error" role="alert" hidden></p>
  </div>
  <div class="dialog-foot progress-foot" id="progress-foot" hidden>
    <a class="btn primary" id="progress-continue" href="/approvals">Continue to approvals</a>
  </div>
</dialog>
