{% from "partials/icon.njk" import icon %}
<nav class="settings-nav" aria-label="Settings sections">
  {% if isAdmin %}
  <a href="/settings" {% if section == 'general' %}aria-current="page"{% endif %}>{{ icon('settings') }}General</a>
  <a href="/settings/notifications" {% if section == 'notifications' %}aria-current="page"{% endif %}>{{ icon('bell') }}Notifications</a>
  <a href="/settings/sources" {% if section == 'sources' %}aria-current="page"{% endif %}>{{ icon('database') }}Sources</a>
  {% endif %}
  <a href="/settings/account" {% if section == 'account' %}aria-current="page"{% endif %}>{{ icon('user') }}Account</a>
</nav>
