{% macro panelIcon(panel, size=16) -%}
{%- if panel == 'amp' -%}
<svg class="panel-icon amp" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 2.7l8.2 4.5v9.6L12 21.3 3.8 16.8V7.2z"/><path d="M3.8 7.2L12 11.7l8.2-4.5"/><path d="M12 11.7v9.6"/></svg>
{%- elif panel == 'pterodactyl' -%}
<svg class="panel-icon pterodactyl" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="2.4" y="3.6" width="19.2" height="16.8" rx="3"/><path d="M6.6 9.4l2.8 2.6-2.8 2.6"/><path d="M11.9 14.6h5.5"/></svg>
{%- else -%}
<span class="mark"></span>
{%- endif -%}
{% endmacro %}
