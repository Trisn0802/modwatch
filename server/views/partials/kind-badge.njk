{% macro kindBadge(kind, label) -%}
{% set text = label or kind | kindLabel %}
<span class="kind-badge kind-{{ kind }}">
  <svg class="kind-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    {%- if kind == 'mod' -%}
    <path d="M9.5 4.5a2.5 2.5 0 0 1 5 0v1h2.5a1 1 0 0 1 1 1V9h-1a2 2 0 0 0 0 4h1v2.5a1 1 0 0 1-1 1H14v1a2.5 2.5 0 0 1-5 0v-1H6.5a1 1 0 0 1-1-1V13h1a2 2 0 0 0 0-4h-1V7.5a1 1 0 0 1 1-1h3z"/>
    {%- elif kind == 'resourcepack' -%}
    <rect x="3.5" y="4.5" width="17" height="15" rx="2"/><circle cx="9" cy="10" r="1.6"/><path d="M4 17l5-4 4 3 3-2.5 4 3.5"/>
    {%- elif kind == 'datapack' -%}
    <ellipse cx="12" cy="6" rx="7" ry="3"/><path d="M5 6v6c0 1.7 3.1 3 7 3s7-1.3 7-3V6"/><path d="M5 12v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6"/>
    {%- elif kind == 'shader' -%}
    <circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M18.7 5.3l-1.4 1.4M6.7 17.3l-1.4 1.4"/>
    {%- else -%}
    <path d="M9.5 4.5a2.5 2.5 0 0 1 5 0v1h2.5a1 1 0 0 1 1 1V9h-1a2 2 0 0 0 0 4h1v2.5a1 1 0 0 1-1 1H14v1a2.5 2.5 0 0 1-5 0v-1H6.5a1 1 0 0 1-1-1V13h1a2 2 0 0 0 0-4h-1V7.5a1 1 0 0 1 1-1h3z"/>
    {%- endif -%}
  </svg>
  <span>{{ text }}</span>
</span>
{%- endmacro %}
