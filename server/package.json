{
  "name": "modwatch-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ModWatch - self-hosted Minecraft modpack update tracker (Express + Nunjucks + PostgreSQL)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "seed:demo": "node src/seed-demo.js",
    "check": "node --check src/app.js && node --check src/scheduler.js && node --check src/import.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "multer": "^2.0.0",
    "nunjucks": "^3.2.4",
    "pg": "^8.13.1",
    "pusher": "^5.3.4",
    "pusher-js": "^8.6.0",
    "sharp": "^0.35.5",
    "smol-toml": "^1.3.1",
    "ssh2-sftp-client": "^12.1.1",
    "yauzl": "^3.2.0",
    "yazl": "^3.3.1"
  }
}
